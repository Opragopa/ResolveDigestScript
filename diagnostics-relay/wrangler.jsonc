{
  "name": "resolve-digest-diagnostics",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-13",
  "kv_namespaces": [{ "binding": "REPORTS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "ratelimits": [{
    "name": "REPORT_LIMIT",
    "namespace_id": "1001",
    "simple": { "limit": 3, "period": 60 }
  }]
}
